# Configuração do Banco de Dados PostgreSQL
# Substitua pela sua URL pública do Railway

DATABASE_URL=postgresql://postgres:sua_senha@monorail.proxy.rlwy.net:12345/railway

# Para obter a URL correta:
# 1. Vá no painel do Railway
# 2. Clique no PostgreSQL
# 3. Copie a "Public URL" ou "Connection URL"
# 4. Cole aqui substituindo a linha acima

# IMPORTANTE: Use a URL PÚBLICA, não a URL interna (.railway.internal)
